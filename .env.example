# Copy this file to .env and fill in real values before running in any
# shared or production environment. Never commit the real .env file.

# Port the app listens on
PORT=3000

# Cookie session signing secret(s). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# You may provide a second, older secret in SESSION_SECRET_OLD during key
# rotation so existing sessions stay valid while you roll the new one out.
SESSION_SECRET=change-this-to-a-long-random-value
SESSION_SECRET_OLD=

# Set to "production" when deployed behind HTTPS. This makes session
# cookies require Secure (HTTPS-only) transport.
NODE_ENV=development

# Path to the SQLite database file.
DB_PATH=./data/complaints.db

# Seed the database with a demo admin account, demo staff, and sample
# complaints the first time it is created (no existing data is ever
# overwritten). Set to "false" to start completely empty.
SEED_DEMO_DATA=true

# Login attempt limiter. Counts every POST /login from a given source IP
# (successful or not) in one shared bucket per window. If staff sit
# behind a single office NAT/proxy, they share this bucket, so keep it
# generous unless you're seeing real brute-force attempts in the audit log.
LOGIN_RATE_LIMIT_MAX=30
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
