<%- include('../partials/header', { title }) %>
<h1>Audit log</h1>
<p class="text-dim">Every login, record change, redaction and export is recorded here (most recent 300 entries) to support PDPA accountability.</p>

<div class="card table-wrap">
  <table>
    <thead>
      <tr><th>When</th><th>Actor</th><th>Action</th><th>Entity</th><th>Details</th></tr>
    </thead>
    <tbody>
      <% entries.forEach(function(a) { %>
        <tr>
          <td class="small mono"><%= a.created_at %></td>
          <td><%= a.actor_name || a.actor_label || 'system' %></td>
          <td><%= a.action.replace(/_/g, ' ') %></td>
          <td class="small">
            <%= a.entity_type %><% if (a.entity_type === 'complaint' && a.reference_no) { %>
              <a href="/complaints/<%= a.entity_id %>"><%= a.reference_no %></a>
            <% } else if (a.entity_id) { %> #<%= a.entity_id %><% } %>
          </td>
          <td class="small text-dim"><%= a.details || '' %></td>
        </tr>
      <% }) %>
      <% if (!entries.length) { %><tr><td colspan="5" class="text-dim">No entries yet.</td></tr><% } %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>
